# Copie ce fichier en .env et remplis les valeurs pour la prise de RDV (Resend).
# Sans RESEND_API_KEY, les emails sont juste loggés en console (mode dev) — le site marche quand même.

# Clé API Resend — https://resend.com
RESEND_API_KEY=

# Adresse d'envoi : DOIT appartenir à un domaine VÉRIFIÉ dans Resend (ex. rdv@scory.dev).
# Par défaut = domaine de test Resend (délivrabilité moyenne, ok en dev).
FROM_EMAIL=onboarding@resend.dev

# Où tu reçois les notifications de RDV / leads.
ADMIN_EMAIL=contact@scory.dev

# Port du backend Fastify.
PORT=8787
